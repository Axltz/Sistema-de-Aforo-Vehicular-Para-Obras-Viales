# ==============================================================================
# Environment configuration — Intelligent Vehicle Counting System for Roadworks
# ==============================================================================
# Copy this file to `.env` and adjust the values to your local setup:
#
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# The `.env` file is NEVER committed to version control (see `.gitignore`).
# All paths are resolved relative to the project root, so relative values work
# regardless of where the process is launched from.
# ==============================================================================

# ------------------------------------------------------------------------------
# PATHS
# ------------------------------------------------------------------------------

# Default video file processed on startup (used by both the CLI and the GUI).
DEFAULT_VIDEO_PATH=data/videos/trafico1.mp4

# YOLO model weights. If the file does not exist, Ultralytics will attempt to
# download it automatically on the first run.
YOLO_MODEL_PATH=models/yolo26n.pt

# Frame snapshot written while the detection loop runs (used by the CLI viewer).
LIVE_FRAME_PATH=data/live_frame.jpg
